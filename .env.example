# Copy this file to .env and fill in one provider key.
# Never commit the real .env file.

OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Defaults used when --model is omitted.
OPENAI_MODEL=gpt-6-luna
OPENROUTER_MODEL=openai/gpt-5.6-luna

# Prices are USD per one million tokens. Update these for the model/provider
# you benchmark; the runner records them in every experiment's metadata.
INPUT_PRICE_PER_MILLION=0.20
CACHED_INPUT_PRICE_PER_MILLION=0.02
OUTPUT_PRICE_PER_MILLION=1.20

# Keeps responses short because routing is the measured task, not generation.
MAX_OUTPUT_TOKENS=512
